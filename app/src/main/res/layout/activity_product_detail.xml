<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="28dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <ProgressBar
            android:id="@+id/progressDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal" />

        <ImageView
            android:id="@+id/imgDetailProduct"
            android:layout_width="match_parent"
            android:layout_height="230dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:contentDescription="Gambar detail produk"
            android:scaleType="fitCenter" />

        <TextView android:id="@+id/tvDetailTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nama produk" android:textSize="23sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvDetailPrice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="$0.00" android:textColor="#176B55" android:textSize="21sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvDetailId" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="ID Produk" />
        <TextView android:id="@+id/tvDetailCategory" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Kategori" />
        <TextView android:id="@+id/tvDetailStock" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Stok" />
        <TextView android:id="@+id/tvDetailStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Status" />
        <TextView android:id="@+id/tvDetailRating" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Rating" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Deskripsi" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvDetailDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Deskripsi produk" android:lineSpacingExtra="3dp" />
        <TextView android:id="@+id/tvDetailTags" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Tags" />
        <TextView android:id="@+id/tvDetailDimensions" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Dimensi" />
        <TextView android:id="@+id/tvReviewHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Ulasan pertama" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvFirstReview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:lineSpacingExtra="3dp" android:text="Ulasan" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnAllReviews" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Lihat semua ulasan" />
    </LinearLayout>
</ScrollView>
